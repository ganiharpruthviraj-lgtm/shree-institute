# Copy to `.env` and fill in. Never commit the real .env.

PORT=5000

# Twilio → Console dashboard → Account Info
TWILIO_ACCOUNT_SID=your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here

# Twilio WhatsApp Sandbox number (Messaging → Try it out → Send a WhatsApp message).
# Leave as-is while testing.
TWILIO_WHATSAPP_FROM=+14155238886

# The institute manager's WhatsApp number, in E.164. This phone must have sent
# `join <sandbox-code>` to the number above at least once, or Twilio rejects it.
MANAGER_WHATSAPP_TO=+919xxxxxxxxx

# Origins allowed to POST to /api/book-demo. Comma-separated, no trailing slash.
# 5180 is the Vite dev server; add your production domain before launch.
ALLOWED_ORIGINS=http://localhost:5180,http://localhost:5181,http://localhost:5173

# Set to true ONLY when the server sits behind a reverse proxy (nginx, Render,
# Railway). Otherwise a client could spoof its IP past the rate limiter.
TRUST_PROXY=false
