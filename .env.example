# Copy to `.env` to override. Vite only exposes VITE_-prefixed variables.

# Base URL of shree-institute/server. Falls back to http://localhost:5000.
VITE_API_BASE_URL=http://localhost:5000

# Optional: Google Apps Script Web App URL to stream leads into Google Sheets
VITE_GOOGLE_SHEET_URL=https://script.google.com/macros/s/your_script_id_here/exec

